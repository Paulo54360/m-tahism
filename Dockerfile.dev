FROM node:22-alpine

WORKDIR /app

# Définition des variables d'écoute pour Astro
ENV HOST=0.0.0.0
ENV PORT=4321

# Installation des dépendances
COPY package*.json ./
RUN npm install

# Copie du reste des fichiers
COPY . .

# Exposition du port Astro
EXPOSE 4321

# Commande de démarrage en développement avec hot-reload
CMD ["npm", "run", "dev", "--", "--host"]
