---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';

const partner = {
  imageId: "Partenaire.Image.3.1",
  nameId: "Partenaire.Nom.3.1",
  titleId: "Titre.3.2",
  textId: "Texte.3.2",
  name: "UNIKALO",
  subtitle: "Fabricant Français de Peintures Bâtiment & Décoration",
  company: "SCSO - Unikalo",
  location: "18 avenue du Meilleur Ouvrier de France, 33700 Mérignac",
  role: "Mécénat en nature — Fourniture exclusive de la peinture",
  object: "Mise à disposition de la peinture nécessaire à la réalisation de l'œuvre",
  framework: "Convention de partenariat et mécénat d'entreprise",
  website: "https://www.unikalo.com",
};
---

<Layout title="Partenariat UNIKALO — Patrick Laumond" currentPath="/partenaires">
  <div class="partners-page">
    <!-- EN-TÊTE DE LA PAGE PARTENAIRE (STYLE ÉDITORIAL CLASSIQUE LAUMOND) -->
    <header class="partners-hero">
      <div class="main-container">
        <div class="hero-top-badge">
          <span class="category-name">Mécénat & Soutien Artistique</span>
        </div>

        <div class="tag-row">
          <span class="artist-tag">Titre.3.1</span>
        </div>
        <h1 class="partners-main-title">
          Partenaire Officiel
          <span class="headline-sub">L'engagement d'UNIKALO aux côtés de Patrick Laumond</span>
        </h1>

        <div class="tag-row">
          <span class="artist-tag">Texte.3.1</span>
        </div>
        <p class="partners-lead-text">
          Texte.3.1 — Dans le cadre de la création monumentale de l'œuvre « Le grand Mikado de la pensée humaine », Patrick Laumond et le mouvement Métahiste s'associent à la maison UNIKALO. Nous exprimons notre sincère gratitude à leurs équipes pour leur soutien et la mise à disposition de l'ensemble de la peinture nécessaire à la concrétisation et à la réalisation de l'œuvre.
        </p>

        <div class="hero-media-wrapper">
          <div class="tag-row">
            <span class="artist-tag">Image.3.1</span>
          </div>
          <ImagePlaceholder
            id="Image.3.1"
            aspectRatio="21 / 9"
            altText="Image.3.1 — Présentation du projet Le grand Mikado de la pensée humaine et collaboration Unikalo"
            caption="Image.3.1 — Concrétisation matérielle de l'œuvre « Le grand Mikado de la pensée humaine » soutenue par Unikalo."
          />
        </div>
      </div>
    </header>

    <!-- SECTION MÉCÉNAT & COLLABORATION (STYLE GALERIE CONTEMPORAINE) -->
    <section class="partner-classic-section">
      <div class="main-container">
        <SectionHeader tag="h2" labelId={partner.titleId}>
          Mécénat de Peinture & Réalisation Monumentale
        </SectionHeader>

        <div class="tag-row">
          <span class="artist-tag">{partner.textId}</span>
        </div>
        <p class="section-description">
          Texte.3.2 — Soutien exclusif apporté à la réalisation matérielle de l'œuvre « Le grand Mikado de la pensée humaine ».
        </p>

        <!-- CARTOUCHE DE PARTENARIAT ÉPURÉ -->
        <article class="partner-document">
          <!-- En-tête du cartel : Logo + Identité -->
          <div class="document-header">
            <div class="document-brand">
              <div class="tag-row">
                <span class="artist-tag">{partner.nameId}</span>
              </div>
              <h3 class="document-title">{partner.name}</h3>
              <p class="document-subtitle">{partner.subtitle}</p>
            </div>

            <div class="document-logo-frame">
              <div class="tag-row">
                <span class="artist-tag">{partner.imageId}</span>
              </div>
              <div class="logo-white-box">
                <img
                  src="/images/partenaires/unikalo.png"
                  alt="Logo officiel UNIKALO"
                  class="partner-logo-img"
                />
              </div>
            </div>
          </div>

          <!-- Ligne de séparation fine -->
          <div class="document-divider"></div>

          <!-- Corps du texte éditorial -->
          <div class="document-body">
            <div class="document-text-column">
              <h4 class="editorial-heading">L'alliance de la matière et de la pensée</h4>
              <p class="editorial-paragraph">
                La maison UNIKALO accompagne Patrick Laumond dans la création de son œuvre monumentale <em>« Le grand Mikado de la pensée humaine »</em> en mettant à sa disposition l'intégralité de la peinture nécessaire à sa concrétisation.
              </p>
              <p class="editorial-paragraph">
                Ce mécénat en nature concrétise une alliance d'excellence entre savoir-faire industriel français et vision artistique métahiste. Il permet à l'artiste de déployer ses recherches de tensions spatiales et de résonances chromatiques avec des matières professionnelles de haute tenue technique.
              </p>
            </div>

            <!-- Cartel technique d'exposition (Notice de mécénat) -->
            <aside class="document-cartel">
              <h5 class="cartel-heading">Notice de Partenariat</h5>
              <dl class="cartel-list">
                <div class="cartel-row">
                  <dt class="cartel-term">Partenaire</dt>
                  <dd class="cartel-desc">{partner.company}</dd>
                </div>
                <div class="cartel-row">
                  <dt class="cartel-term">Implantation</dt>
                  <dd class="cartel-desc">{partner.location}</dd>
                </div>
                <div class="cartel-row">
                  <dt class="cartel-term">Nature du soutien</dt>
                  <dd class="cartel-desc">{partner.role}</dd>
                </div>
                <div class="cartel-row">
                  <dt class="cartel-term">Cadre</dt>
                  <dd class="cartel-desc">{partner.framework}</dd>
                </div>
              </dl>

              <div class="cartel-action">
                <a
                  href={partner.website}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="link-partner-external"
                >
                  Consulter unikalo.com ↗
                </a>
              </div>
            </aside>
          </div>
        </article>
      </div>
    </section>
  </div>
</Layout>

<style lang="scss">
  @use '../styles/variables' as *;
  @use '../styles/mixins' as *;

  .partners-page {
    background-color: $color-background;
  }

  // --- En-tête de la page ---
  .partners-hero {
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
    border-bottom: 1px solid $color-border-light;
  }

  .hero-top-badge {
    margin-bottom: $spacing-md;

    .category-name {
      font-size: 0.78rem;
      font-weight: $font-weight-semibold;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: $color-primary;
    }
  }

  .partners-main-title {
    font-size: clamp(2rem, 4vw, 3.4rem);
    font-weight: $font-weight-light;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: $color-text;
    line-height: 1.2;
    margin-bottom: $spacing-lg;

    .headline-sub {
      display: block;
      font-size: clamp(1.1rem, 2vw, 1.35rem);
      font-weight: $font-weight-regular;
      letter-spacing: 0.05em;
      color: $color-text-light;
      margin-top: $spacing-sm;
      text-transform: none;
    }
  }

  .partners-lead-text {
    font-size: clamp(1rem, 1.4vw, 1.1rem);
    line-height: 1.8;
    color: $color-text;
    max-width: 900px;
    margin-bottom: $spacing-xl;
    font-weight: $font-weight-regular;
  }

  .hero-media-wrapper {
    width: 100%;
    margin-top: $spacing-xl;
  }

  // --- Section Partenaire (Style Classique Laumond) ---
  .partner-classic-section {
    @include section-padding;
    background-color: $color-background;
  }

  .section-description {
    font-size: 0.98rem;
    color: $color-text;
    line-height: 1.65;
    max-width: 850px;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  // --- Document de Partenariat (Cartel de Galerie) ---
  .partner-document {
    background-color: $color-white;
    border: 1px solid $color-border;
    border-radius: 0;
    padding: clamp(2rem, 4vw, 3.5rem);
    box-shadow: none;
  }

  .document-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: $spacing-xl;
    flex-wrap: wrap;

    .document-brand {
      flex: 1;
      min-width: 260px;
    }

    .document-title {
      font-size: clamp(1.8rem, 3vw, 2.4rem);
      font-weight: $font-weight-light;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: $color-text;
      margin: $spacing-xs 0 0.35rem 0;
      line-height: 1.15;
    }

    .document-subtitle {
      font-size: 0.98rem;
      color: $color-text-light;
      margin: 0;
      letter-spacing: 0.02em;
    }

    .document-logo-frame {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: $spacing-xs;

      @media (max-width: 600px) {
        align-items: flex-start;
        width: 100%;
      }

      .logo-white-box {
        border: 1px solid $color-border-light;
        border-radius: 0;
        padding: 0.85rem 1.6rem;
        background-color: $color-white;
        display: flex;
        align-items: center;
        justify-content: center;

        .partner-logo-img {
          height: 38px;
          width: auto;
          max-width: 160px;
          object-fit: contain;
        }
      }
    }
  }

  .document-divider {
    height: 1px;
    background-color: $color-border-light;
    margin: clamp(1.5rem, 3vw, 2.5rem) 0;
  }

  // Corps du document
  .document-body {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: clamp(2rem, 4vw, 3.5rem);

    @media (max-width: 860px) {
      grid-template-columns: 1fr;
    }
  }

  .document-text-column {
    .editorial-heading {
      font-size: 1.15rem;
      font-weight: $font-weight-medium;
      color: $color-text;
      letter-spacing: 0.02em;
      margin: 0 0 $spacing-md 0;
    }

    .editorial-paragraph {
      font-size: 1rem;
      line-height: 1.8;
      color: $color-text;
      margin: 0 0 $spacing-md 0;

      &:last-child {
        margin-bottom: 0;
      }
    }
  }

  // Cartel technique (style cartel d'exposition sobre)
  .document-cartel {
    border-left: 1px solid $color-border-light;
    padding-left: clamp(1.5rem, 3vw, 2.5rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;

    @media (max-width: 860px) {
      border-left: none;
      border-top: 1px solid $color-border-light;
      padding-left: 0;
      padding-top: $spacing-lg;
    }

    .cartel-heading {
      font-size: 0.78rem;
      font-weight: $font-weight-semibold;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: $color-primary;
      margin: 0 0 $spacing-md 0;
      padding-bottom: 0.35rem;
      border-bottom: 1px solid $color-border-light;
    }

    .cartel-list {
      display: flex;
      flex-direction: column;
      gap: $spacing-md;
      margin: 0 0 $spacing-xl 0;
    }

    .cartel-row {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }

    .cartel-term {
      font-size: 0.72rem;
      font-weight: $font-weight-semibold;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: $color-muted-dark;
    }

    .cartel-desc {
      font-size: 0.88rem;
      color: $color-text;
      line-height: 1.45;
      margin: 0;
    }

    .cartel-action {
      margin-top: auto;
      padding-top: $spacing-md;
    }

    .link-partner-external {
      display: inline-block;
      font-size: 0.82rem;
      font-weight: $font-weight-medium;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: $color-primary;
      text-decoration: none;
      border-bottom: 1px solid $color-primary;
      padding-bottom: 2px;
      transition: color $transition-fast, border-color $transition-fast;

      &:hover {
        color: $color-primary-dark;
        border-color: $color-primary-dark;
      }
    }
  }
</style>
