---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';

// Définition des jalons de la frise chronologique avec liaisons S3
const timelineSteps = [
  {
    period: "Phase 01 — Genèse",
    titleId: "Titre.1.3",
    titleDefault: "L'Émergence du Métahisme & Premières Toiles",
    textId: "Texte.1.2",
    textContent: "Texte.1.2 — Exploration des structures fractales et des premières intuitions du Métahisme. Naissance de la grille géométrique et confrontation de la matière brute avec la dimension spirituelle.",
    imageId: "Image.1.2",
    s3Key: "artworks/genese-metahiste-hd.webp",
    imageCaption: "Image.1.2 — Œuvre fondatrice de la première période, technique mixte sur lin.",
    artworkYear: "2018 - 2020",
  },
  {
    period: "Phase 02 — Déploiement",
    titleId: "Titre.1.4",
    titleDefault: "Déstructuration & Métamorphose des Symboles",
    textId: "Texte.1.3",
    textContent: "Texte.1.3 — Période charnière marquant l'introduction des lignes de tension dynamiques. L'espace pictural s'ouvre sur une cartographie mentale complexe défiant la perspective conventionnelle.",
    imageId: "Image.1.3",
    s3Key: "artworks/interferences-fractales-4-hd.webp",
    imageCaption: "Image.1.3 — Vue de détail sur les entrelacs chromatiques et la texture pigmentaire.",
    artworkYear: "2021 - 2023",
  },
  {
    period: "Phase 03 — Climax",
    titleId: "Titre.1.5",
    titleDefault: "Le Grand Mikado de la Pensée Humaine",
    textId: "Texte.1.4",
    textContent: "Texte.1.4 — Synthèse monumentale où convergent des centaines de trajectoires convergentes et divergentes. L'œuvre maîtresse devient le miroir des interactions cognitives et sociétales de notre ère.",
    imageId: "Image.1.4",
    s3Key: "artworks/le-grand-mikado-de-la-pensee-humaine-hd.webp",
    imageCaption: "Image.1.4 — Panorama haute définition du Grand Mikado, format monumental.",
    artworkYear: "2024 - 2025",
  },
  {
    period: "Phase 04 — Horizons",
    titleId: "Titre.1.6",
    titleDefault: "Résonances Quantiques & Nouvelles Écritures",
    textId: "Texte.1.5",
    textContent: "Texte.1.5 — Recherches contemporaines intégrant la réfraction lumineuse, les encres métahistes et l'interaction avec le spectateur dans un espace muséal immersif.",
    imageId: "Image.1.5",
    s3Key: "artworks/equilibre-precaire-7-hd.webp",
    imageCaption: "Image.1.5 — Prototype expérimental de la nouvelle série en cours d'achèvement.",
    artworkYear: "2026 - Présent",
  },
];
---

<Layout title="Frise Chronologique — Patrick Laumond" currentPath="/">
  <!-- HERO SECTION INSPIRÉE DE LA HOMEPAGE LAUMOND.COM -->
  <section class="hero-section">
    <div class="main-container hero-container">
      <div class="hero-text-block">
        <div class="tag-row">
          <span class="artist-tag">Titre.1.1</span>
        </div>
        <h1 class="hero-main-title">
          Patrick Laumond
          <span class="hero-sub-title">Frise Chronologique de l'Œuvre</span>
        </h1>

        <div class="tag-row">
          <span class="artist-tag">Texte.1.1</span>
        </div>
        <p class="hero-lead-text">
          Texte.1.1 — Le parcours artistique de Patrick Laumond se déploie à travers le Métahisme, un courant pictural et conceptuel interrogeant la structure sous-jacente de la conscience humaine. Cette frise verticale invite à traverser les cycles créatifs qui ont jalonné la genèse du Grand Mikado.
        </p>

        <div class="hero-cta-group">
          <a href="#timeline" class="btn-primary-action">
            Explorer la Frise
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 13l5 5 5-5M7 6l5 5 5-5"/></svg>
          </a>
          <a href="/interview" class="btn-secondary-action">
            Lire l'Entretien Dédié →
          </a>
        </div>
      </div>

      <div class="hero-visual-block">
        <div class="visual-tag-top">
          <span class="artist-tag">Image.1.1</span>
        </div>
        <ImagePlaceholder
          id="Image.1.1"
          s3Key="artworks/le-grand-mikado-de-la-pensee-humaine-hd.webp"
          aspectRatio="4 / 3"
          altText="Image.1.1 — Vue panoramique d'introduction ou vidéo 360°"
          caption="Image.1.1 — Œuvre signature inaugurale ou visualiseur immersif."
        />
      </div>
    </div>
  </section>

  <!-- SECTION FRISE CHRONOLOGIQUE VERTICALE -->
  <section id="timeline" class="timeline-section">
    <div class="main-container">
      <div class="section-intro">
        <SectionHeader tag="h2" labelId="Titre.1.2" accent="green">
          Frise Chronologique
        </SectionHeader>
      </div>

      <!-- Conteneur Frise Verticale avec Ligne Axe -->
      <div class="vertical-timeline">
        <div class="timeline-axis-line"></div>

        {timelineSteps.map((step, index) => {
          const isEven = index % 2 === 1;
          return (
            <div class={`timeline-item ${isEven ? 'timeline-item--reversed' : ''}`}>
              <!-- Nœud jalon sur la ligne centrale -->
              <div class="timeline-node">
                <span class="node-number">0{index + 1}</span>
                <span class="node-dot"></span>
              </div>

              <!-- Bloc Contenu Texte -->
              <div class="timeline-content-card">
                <div class="card-header-tags">
                  <span class="timeline-period-badge">{step.period}</span>
                  <span class="timeline-year-text">{step.artworkYear}</span>
                </div>

                <div class="tag-row">
                  <span class="artist-tag">{step.titleId}</span>
                </div>
                <h3 class="timeline-step-title">{step.titleDefault}</h3>

                <div class="tag-row">
                  <span class="artist-tag">{step.textId}</span>
                </div>
                <p class="timeline-step-text">{step.textContent}</p>
              </div>

              <!-- Bloc Image Associée -->
              <div class="timeline-media-card">
                <div class="tag-row">
                  <span class="artist-tag">{step.imageId}</span>
                </div>
                <ImagePlaceholder
                  id={step.imageId}
                  s3Key={step.s3Key}
                  aspectRatio="16 / 10"
                  altText={step.imageId}
                  caption={step.imageCaption}
                />
              </div>
            </div>
          );
        })}
      </div>

      <!-- Conclusion de la Frise -->
      <div class="timeline-conclusion-card">
        <div class="tag-row">
          <span class="artist-tag">Titre.1.7</span>
        </div>
        <h3 class="conclusion-title">Perspectives & Prochaines Expositions</h3>

        <div class="tag-row">
          <span class="artist-tag">Texte.1.6</span>
        </div>
        <p class="conclusion-text">
          Texte.1.6 — Le corpus des œuvres du Métahisme poursuit sa diffusion internationale. Pour approfondir les fondements philosophiques et formels de cette trajectoire, accédez à l'interview rétrospective de Patrick Laumond consacrée au chef-d'œuvre du Grand Mikado.
        </p>

        <div class="tag-row">
          <span class="artist-tag">Image.1.6</span>
        </div>
        <ImagePlaceholder
          id="Image.1.6"
          s3Key="artworks/totem-du-reel-hd.webp"
          aspectRatio="21 / 9"
          altText="Image.1.6 — Vue scénographique finale d'ensemble"
          caption="Image.1.6 — Scénographie de l'espace d'exposition métahiste."
        />
      </div>
    </div>
  </section>
</Layout>

<style lang="scss">
  @use '../styles/variables' as *;
  @use '../styles/mixins' as *;

  .tag-row {
    margin-bottom: 0.35rem;
  }

  // --- Hero Section ---
  .hero-section {
    background-color: $color-background;
    padding-top: clamp(2rem, 5vw, 4.5rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
    border-bottom: 1px solid $color-border-light;
    --card-hover-border: #{$color-green-symbol};
    --badge-accent-color: #{$color-green-symbol};
    --accent-divider: #{$color-green-symbol};

    .artist-tag {
      background-color: rgba(9, 70, 41, 0.06);
      border-color: rgba(9, 70, 41, 0.25);
      color: $color-green-symbol;
    }
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;

    @include respond-to('tablet') {
      grid-template-columns: 1fr;
    }
  }

  .hero-text-block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-main-title {
    font-size: clamp(2rem, 4vw, 3.4rem);
    font-weight: 400;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: $color-text;
    line-height: 1.1;
    margin-bottom: $spacing-lg;

    .hero-sub-title {
      display: block;
      font-size: clamp(1rem, 1.8vw, 1.25rem);
      font-weight: 400;
      letter-spacing: 0.05em;
      color: $color-text-light;
      margin-top: $spacing-sm;
      text-transform: none;
    }
  }

  .hero-lead-text {
    font-size: clamp(0.95rem, 1.5vw, 1.1rem);
    color: $color-text;
    line-height: 1.7;
    margin-bottom: $spacing-xl;
  }

  .hero-cta-group {
    display: flex;
    align-items: center;
    gap: $spacing-md;
    flex-wrap: wrap;
  }

  .btn-primary-action {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: $color-green-symbol;
    color: $color-white;
    padding: 0.8rem 1.8rem;
    border: 1px solid $color-green-symbol;
    border-radius: 0;
    font-size: 0.82rem;
    font-weight: $font-weight-regular;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    box-shadow: none;
    transition: all $transition-fast;

    &:hover {
      background-color: $color-green-symbol-dark;
      border-color: $color-green-symbol-dark;
      color: $color-white;
    }
  }

  .btn-secondary-action {
    display: inline-flex;
    align-items: center;
    background-color: transparent;
    color: $color-text;
    border: 1px solid $color-border-strong;
    padding: 0.8rem 1.8rem;
    border-radius: 0;
    font-size: 0.82rem;
    font-weight: $font-weight-regular;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    box-shadow: none;
    transition: all $transition-fast;

    &:hover {
      border-color: $color-green-symbol;
      color: $color-green-symbol;
      background-color: transparent;
    }
  }

  .hero-visual-block {
    position: relative;
    width: 100%;
  }

  .visual-tag-top {
    margin-bottom: $spacing-xs;
  }

  // --- Timeline Section ---
  .timeline-section {
    background-color: $color-background-alt;
    @include section-padding;
    --card-hover-border: #{$color-green-symbol};
    --badge-accent-color: #{$color-green-symbol};
    --accent-divider: #{$color-green-symbol};

    .artist-tag {
      background-color: rgba(9, 70, 41, 0.06);
      border-color: rgba(9, 70, 41, 0.25);
      color: $color-green-symbol;
    }
  }

  .section-intro {
    margin-bottom: clamp(2rem, 4vw, 4rem);
  }

  .vertical-timeline {
    position: relative;
    width: 100%;
    margin: 0 auto;
    padding: $spacing-xl 0;
  }

  // Axe vertical central
  .timeline-axis-line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 2px;
    background-color: $color-border;
    transform: translateX(-50%);

    @include respond-to('tablet') {
      left: 20px;
    }
  }

  .timeline-item {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    margin-bottom: clamp(3rem, 6vw, 6rem);

    @include respond-to('tablet') {
      grid-template-columns: 1fr;
      padding-left: 50px;
      gap: $spacing-lg;
    }

    &--reversed {
      direction: rtl;

      @include respond-to('tablet') {
        direction: ltr;
      }

      .timeline-content-card,
      .timeline-media-card {
        direction: ltr;
      }
    }
  }

  .timeline-node {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    pointer-events: none;

    @include respond-to('tablet') {
      left: 20px;
      top: 2rem;
      transform: translateX(-50%);
    }

    .node-number {
      font-size: 0.72rem;
      font-weight: $font-weight-bold;
      color: $color-green-symbol;
      background: $color-white;
      padding: 0.15rem 0.45rem;
      border-radius: 0;
      border: 1px solid $color-border;
      box-shadow: none;
    }

    .node-dot {
      width: 10px;
      height: 10px;
      border-radius: 0;
      background-color: $color-green-symbol;
      border: none;
      box-shadow: none;
    }
  }

  .timeline-content-card {
    background-color: $color-white;
    border: 1px solid $color-border;
    border-radius: 0;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    box-shadow: none;
    transition: border-color $transition-fast;

    &:hover {
      box-shadow: none;
      border-color: $color-green-symbol;
    }

    .card-header-tags {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: $spacing-sm;
      margin-bottom: $spacing-md;
      padding-bottom: $spacing-xs;
      border-bottom: 1px solid $color-border-light;
    }

    .timeline-period-badge {
      font-size: 0.78rem;
      font-weight: $font-weight-semibold;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: $color-green-symbol;
    }

    .timeline-year-text {
      font-size: 0.78rem;
      font-weight: $font-weight-regular;
      color: $color-muted;
    }

    .timeline-step-title {
      font-size: clamp(1.2rem, 2vw, 1.6rem);
      font-weight: $font-weight-regular;
      color: $color-text;
      line-height: 1.35;
      margin-bottom: $spacing-md;
    }

    .timeline-step-text {
      font-size: 0.95rem;
      color: $color-text;
      line-height: 1.65;
      margin: 0;
    }
  }

  .timeline-media-card {
    width: 100%;
  }

  // Conclusion card
  .timeline-conclusion-card {
    background-color: $color-white;
    border: 1px solid $color-border;
    border-radius: 0;
    padding: clamp(2rem, 4vw, 3.5rem);
    box-shadow: none;
    margin-top: $spacing-3xl;

    .conclusion-title {
      font-size: clamp(1.4rem, 2.5vw, 2rem);
      font-weight: $font-weight-light;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: $color-text;
      margin-bottom: $spacing-md;
    }

    .conclusion-text {
      font-size: 1rem;
      line-height: 1.7;
      color: $color-text;
      max-width: 900px;
      margin-bottom: $spacing-xl;
    }
  }
</style>
