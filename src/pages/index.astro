---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import { supabase } from '../db/supabase';
import { parseImageUrls } from '../data/artworks';

interface TimelineImageItem {
  year: string;
  imageId: string;
  s3Key: string;
  imageCaption: string;
  title?: string;
  dimensions?: string;
  technique?: string;
  description?: string;
}

interface TimelineCategoryGroup {
  key: string;
  label: string;
  subtitle: string;
  year: string;
  categoryIds: number[];
  items: TimelineImageItem[];
}

// Récupération dynamique depuis Supabase des œuvres "Le Grand Mikado de la pensée humaine"
let mikadoArtworks: Record<string, any>[] = [];
if (supabase) {
  const { data, error } = await supabase
    .from('artworks')
    .select('*')
    .ilike('title', '%Mikado%')
    .is('deleted_at', null)
    .order('id', { ascending: true });

  if (error) {
    console.error('[Index] Erreur Supabase lors du chargement de la chronologie :', error.message);
  } else if (data) {
    mikadoArtworks = data;
  }
}

// Définition des 4 grandes catégories dans l'ordre chronologique de création
const categoryGroups: TimelineCategoryGroup[] = [
  {
    key: 'dessins',
    label: 'Les Dessins',
    subtitle: "Réflexion initiale née de l'imagination de Patrick Laumond",
    year: '2023',
    categoryIds: [12, 15],
    items: [],
  },
  {
    key: 'transcriptions',
    label: 'Les Transcriptions',
    subtitle: "Définir l'œuvre dans l'espace",
    year: '2023',
    categoryIds: [9],
    items: [
      {
        year: '2023',
        imageId: 'Image.1.2',
        s3Key: 'https://plaumondpicture.s3.eu-west-3.amazonaws.com/metahism/Le+grand+Mikado+de+la+pensee+humaine+-+Transcription+.+Vue+de+dessus.jpg',
        imageCaption: 'Première transcription du grand Mikado de la pensée humaine - vue du dessus.',
      },
    ],
  },
  {
    key: 'archetypes',
    label: 'Les Archétypes',
    subtitle: "Prototype de l'œuvre finale",
    year: '2024',
    categoryIds: [10, 13],
    items: [],
  },
  {
    key: 'deploiements',
    label: 'Le Déploiement',
    subtitle: "Mise en place de l'œuvre",
    year: '2025',
    categoryIds: [11, 14],
    items: [],
  },
];

// Regroupement des images issues de la base Supabase par catégorie
let dynamicIndex = 3;
for (const artwork of mikadoArtworks || []) {
  const urls = parseImageUrls(artwork.image_urls);
  const group = categoryGroups.find((g) => g.categoryIds.includes(Number(artwork.category_id)));
  if (!group || urls.length === 0) continue;

  const createdYear = artwork.created_at ? String(new Date(artwork.created_at).getFullYear()) : group.year;
  for (const url of urls) {
    // Éviter les doublons si l'URL est déjà présente
    if (group.items.some((it) => it.s3Key === url)) continue;
    group.items.push({
      year: createdYear,
      imageId: `Image.1.${dynamicIndex++}`,
      s3Key: url,
      title: artwork.title || 'Le Grand Mikado de la pensée humaine',
      dimensions: group.label,
      technique: `${group.label} — ${ group.subtitle }`,
      description: artwork.description || `${artwork.title} (${group.label})`,
      imageCaption: artwork.description
        ? `${artwork.title} — ${artwork.description}`
        : artwork.title,
    });
  }
}

const activeCategoryGroups = categoryGroups.filter((g) => g.items.length > 0);
---

<Layout title="Chronologie — Patrick Laumond" currentPath="/">
  <!-- HERO SECTION INSPIRÉE DE LA HOMEPAGE LAUMOND.COM -->
  <section class="hero-section">
    <div class="main-container hero-container">
      <div class="hero-text-block">
        <h1 class="hero-main-title">
          Patrick Laumond
          <span class="hero-sub-title">Chronologie de l'Œuvre</span>
        </h1>

        <p class="hero-lead-text">
          Cette chronologie retrace le cheminement de l'oeuvre ≪ Le grand Mikado de la pensée humaine ≫, partant de l'idée première jusqu'à sa réalisation : <strong>les dessins</strong>, réflexion initiale née de l'imagination de Patrick Laumond ; <strong>les transcriptions</strong>, qui viennent définir l'œuvre dans l'espace ; <strong>les archétypes</strong>, conçus comme le prototype de l'œuvre finale; et enfin <strong>le déploiement</strong>, marquant la mise en place de l'œuvre in situ.
        </p>

        <div class="hero-cta-group">
          <a href="#timeline" class="btn-primary-action">
            Explorer la Chronologie
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 13l5 5 5-5M7 6l5 5 5-5"/></svg>
          </a>
          <a href="/interview" class="btn-secondary-action">
            Lire l'Entretien Dédié →
          </a>
        </div>
      </div>

      <div class="hero-visual-block">
        <div class="visual-tag-top">
          <span class="artist-tag">Image.1.1</span>
        </div>
        <ImagePlaceholder
          id="Image.1.1"
          s3Key="https://plaumondpicture.s3.eu-west-3.amazonaws.com/metahism/laumomd.jpg"
          aspectRatio="4 / 3"
          altText="Image.1.1 — Vue panoramique d'introduction ou vidéo 360°"
          caption="Image.1.1 — Œuvre signature inaugurale ou visualiseur immersif."
        />
      </div>
    </div>
  </section>

  <!-- SECTION FRISE CHRONOLOGIQUE VERTICALE -->
  <section id="timeline" class="timeline-section">
    <div class="main-container">
      <div class="section-intro">
        <SectionHeader tag="h2" labelId="Titre.1.2" accent="green">
        Chronologie
        </SectionHeader>
      </div>

      <!-- Conteneur Chronologie Verticale regroupée par Catégorie -->
      <div class="vertical-timeline">
        <div class="timeline-axis-line"></div>

        {activeCategoryGroups.map((group) => (
          <div class="timeline-category-group">
            <!-- Titre de catégorie aligné à droite (visuel identique au bouton principal) -->
            <div class="timeline-category-header">
              <span class="node-category-badge">{group.label}</span>
            </div>

            <!-- Nœud centré sur l'axe chronologique -->
            <div class="timeline-node timeline-node--category">
              <span class="node-dot"></span>
            </div>

            <div class="timeline-category-items">
              {group.items.map((step) => (
                <div class="timeline-item">
                  <!-- Unique Bloc Image + Légende symbolisant l'étape -->
                  <div class="timeline-media-card">
                    <ImagePlaceholder
                      id={step.imageId}
                      s3Key={step.s3Key}
                      aspectRatio="16 / 10"
                      altText={step.imageCaption}
                      caption={step.imageCaption}
                      title={step.title}
                      year={step.year}
                      dimensions={step.dimensions}
                      technique={step.technique}
                      description={step.description}
                    />
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style lang="scss">
  @use '../styles/variables' as *;
  @use '../styles/mixins' as *;

  // --- Hero Section ---
  .hero-section {
    background-color: $color-background;
    padding-top: clamp(2rem, 5vw, 4.5rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
    border-bottom: 1px solid $color-border-light;
    @include green-accent-scope;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;

    @include respond-to('tablet') {
      grid-template-columns: 1fr;
    }
  }

  .hero-text-block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-main-title {
    font-size: clamp(2rem, 4vw, 3.4rem);
    font-weight: 400;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: $color-text;
    line-height: 1.1;
    margin-bottom: $spacing-lg;

    .hero-sub-title {
      display: block;
      font-size: clamp(1rem, 1.8vw, 1.25rem);
      font-weight: 400;
      letter-spacing: 0.05em;
      color: $color-text-light;
      margin-top: $spacing-sm;
      text-transform: none;
    }
  }

  .hero-lead-text {
    font-size: clamp(0.95rem, 1.5vw, 1.1rem);
    color: $color-text;
    line-height: 1.7;
    margin-bottom: $spacing-xl;
  }

  .hero-cta-group {
    display: flex;
    align-items: center;
    gap: $spacing-md;
    flex-wrap: wrap;
  }

  .btn-primary-action {
    @include gallery-button-primary($color-green-symbol, $color-green-symbol-dark);
  }

  .btn-secondary-action {
    @include gallery-button-secondary($color-green-symbol, $color-border-strong);
  }

  .hero-visual-block {
    position: relative;
    width: 100%;
  }

  .visual-tag-top {
    margin-bottom: $spacing-xs;
  }

  // --- Timeline Section ---
  .timeline-section {
    background-color: $color-background-alt;
    @include section-padding;
    @include green-accent-scope;
  }

  .section-intro {
    margin-bottom: clamp(2rem, 4vw, 4rem);
  }

  .vertical-timeline {
    position: relative;
    width: 100%;
    max-width: 860px;
    margin: 0 auto;
    padding: $spacing-xl 0;
  }

  // Axe vertical central
  .timeline-axis-line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 2px;
    background-color: $color-border;
    transform: translateX(-50%);
  }

  .timeline-category-group {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: $spacing-lg;
    margin-bottom: clamp(4rem, 7vw, 6rem);

    &:last-child {
      margin-bottom: 0;
    }
  }

  .timeline-category-items {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 4vw, 3.5rem);
  }

  .timeline-item {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  .timeline-category-header {
    position: relative;
    z-index: 10;
    width: 100%;
    display: flex;
    justify-content: flex-end;
  }

  .node-category-badge {
    @include gallery-button-primary($color-green-symbol, $color-green-symbol);
    cursor: default;
    transform: translateX(50%);

    @include respond-to('tablet') {
      transform: none;
    }
  }

  .timeline-node {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    pointer-events: none;

    .node-number {
      font-size: 0.75rem;
      font-weight: $font-weight-bold;
      color: $color-green-symbol;
      background: $color-white;
      padding: 0.2rem 0.55rem;
      border-radius: 0;
      border: 1px solid $color-border;
      box-shadow: none;
    }

    .node-dot {
      width: 10px;
      height: 10px;
      border-radius: 0;
      background-color: $color-green-symbol;
      border: none;
      box-shadow: none;
    }
  }

  .timeline-media-card {
    position: relative;
    z-index: 5;
    width: 100%;
    background-color: $color-white;
    border: 1px solid $color-border;
    padding: clamp(1rem, 2.5vw, 1.75rem);
    transition: border-color $transition-fast;

    &:hover {
      border-color: $color-green-symbol;
    }
  }
</style>
