---
interface Props {
  tag?: 'h1' | 'h2' | 'h3';
  labelId?: string;
  animated?: boolean;
}

const { tag = 'h2', labelId, animated = true } = Astro.props;
const TitleTag = tag;
---

<div class={`section-header ${animated ? 'section-header--animated' : ''}`}>
  {labelId && <span class="artist-tag">{labelId}</span>}
  <TitleTag class="section-title">
    <slot />
  </TitleTag>
  <div class="section-divider"></div>
</div>

<style lang="scss">
  @use '../styles/variables' as *;
  @use '../styles/mixins' as *;

  .section-header {
    @include section-header(true);

    .artist-tag {
      margin-bottom: 0.2rem;
    }
  }
</style>
