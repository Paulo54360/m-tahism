---
interface Props {
  tag?: 'h1' | 'h2' | 'h3';
  labelId?: string;
  animated?: boolean;
}

const { tag = 'h2', labelId, animated = true } = Astro.props;
const TitleTag = tag;
---

<div class={`section-header ${animated ? 'section-header--animated' : ''}`}>
  {labelId && <span class="artist-tag">{labelId}</span>}
  <TitleTag class="section-title">
    <slot />
  </TitleTag>
  <div class="section-divider"></div>
</div>

<style lang="scss">
  @use '../styles/variables' as *;
  @use '../styles/mixins' as *;

  .section-header {
    @include section-header(true);
    margin-bottom: clamp(1.8rem, 3.5vw, 3rem);
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;

    .artist-tag {
      margin-bottom: 0.2rem;
    }

    .section-title {
      font-size: clamp(1.8rem, 3.5vw, 2.6rem);
      font-weight: $font-weight-light;
      color: $color-text-light;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      line-height: 1.25;
      margin: 0;
      transition: color $transition-normal;
    }

    .section-divider {
      height: 3px;
      background-color: $color-primary;
      width: 60px;
      border-radius: 0;
      transition: width $transition-smooth, background-color $transition-normal;
    }

    &:hover {
      .section-title {
        color: $color-text;
      }
      .section-divider {
        width: 100%;
      }
    }
  }
</style>
