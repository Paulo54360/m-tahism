---
import { getS3MediaUrl, isExplicitS3Url } from '../utils/s3';
import { artworksData } from '../data/artworks';
import type { Artwork } from '../types/artwork';

interface Props {
  id: string;
  caption?: string;
  aspectRatio?: string;
  altText?: string;
  artworkId?: string;
  s3Key?: string;
  src?: string;
  title?: string;
  year?: string;
  dimensions?: string;
  technique?: string;
  description?: string;
  tags?: string[];
}

const {
  id,
  caption,
  aspectRatio = '16 / 9',
  altText,
  artworkId,
  s3Key,
  src,
  title,
  year,
  dimensions,
  technique,
  description,
  tags,
} = Astro.props;

// Résolution unique de l'œuvre associée dans le catalogue statique
const matchedArtwork = artworksData.find(
  (a) => (artworkId && a.id === artworkId) || a.artistRef === id
);

// Source d'image prioritaire : src directe > URL S3 explicite (http/metahism) > imageUrl BDD > URL S3 résolue
const explicitS3 = isExplicitS3Url(s3Key);
const effectiveS3Key = s3Key || matchedArtwork?.s3Key || `artworks/${id.toLowerCase().replace('.', '-')}.webp`;
const effectiveSrc =
  src ||
  (explicitS3 && s3Key ? getS3MediaUrl(s3Key) : '') ||
  matchedArtwork?.imageUrl ||
  (s3Key ? getS3MediaUrl(s3Key) : matchedArtwork?.s3Key ? getS3MediaUrl(matchedArtwork.s3Key) : '');

// Objet Artwork complet pré-résolu côté serveur pour la modale
const resolvedArtwork: Artwork = matchedArtwork
  ? {
      ...matchedArtwork,
      title: title || matchedArtwork.title,
      year: year || matchedArtwork.year,
      dimensions: dimensions || matchedArtwork.dimensions,
      technique: technique || matchedArtwork.technique,
      description: description || matchedArtwork.description,
      s3Key: explicitS3 && s3Key ? s3Key : matchedArtwork.s3Key,
      imageUrl: effectiveSrc || matchedArtwork.imageUrl,
    }
  : {
      id: artworkId || id || 'artwork',
      title: title || altText || `Œuvre de référence ${id}`,
      year: year || '2024',
      dimensions: dimensions || 'Format monumental variable',
      technique: technique || 'Technique mixte Métahiste sur lin',
      s3Key: effectiveS3Key,
      imageUrl: effectiveSrc,
      description:
        description ||
        caption ||
        `Emplacement réservé pour l'œuvre ${id}. L'asset est relié au bucket AWS S3 plaumondpicture (eu-west-3).`,
      tags: tags || ['métahisme', 'patrick laumond', 'exposition', 's3'],
      artistRef: id || 'Image',
    };
---

<figure
  class="image-placeholder-card"
  data-artwork={JSON.stringify(resolvedArtwork)}
>
  <div
    class="image-frame"
    style={`aspect-ratio: ${aspectRatio};`}
    role="button"
    tabindex="0"
    title="Cliquer pour contempler l'œuvre & les métadonnées"
  >
    <!-- Tag Artiste Collaboratif permanent (Angle vif 90°) -->
    <div class="card-tag">
      <span class="artist-tag">{id}</span>
      {effectiveS3Key && <span class="s3-indicator-badge">S3</span>}
    </div>

    <!-- Badge Zoom & Plein écran (Angle vif 90°) -->
    <div class="card-zoom-badge">
      <span>🔎 Zoom HD</span>
    </div>

    <!-- Image réelle chargée directement sans arrondi -->
    {effectiveSrc ? (
      <img
        src={effectiveSrc}
        alt={altText || resolvedArtwork.title || id}
        class="real-artwork-image"
        loading="lazy"
        decoding="async"
      />
    ) : null}

    <!-- Cadre de cadrage géométrique (Placeholder si aucun asset) -->
    <div class="frame-content" style={effectiveSrc ? 'display: none;' : 'display: flex;'}>
      <div class="art-grid-lines">
        <div class="cross-h"></div>
        <div class="cross-v"></div>
      </div>
      <div class="frame-symbol">✛</div>
      <div class="frame-label">{altText || id}</div>
      <span class="frame-hint">
        {effectiveS3Key ? `Asset S3 : ${effectiveS3Key}` : "Emplacement média HD"}
      </span>
    </div>
  </div>

  {caption && (
    <figcaption class="image-caption">
      <span class="caption-marker">Fig. {id}</span>
      <span class="caption-text">{caption}</span>
    </figcaption>
  )}
</figure>

<script>
  document.querySelectorAll<HTMLElement>('.image-placeholder-card').forEach((card) => {
    const frame = card.querySelector<HTMLElement>('.image-frame');
    const img = card.querySelector<HTMLImageElement>('.real-artwork-image');
    const fallback = card.querySelector<HTMLElement>('.frame-content');

    // Bascule propre vers le placeholder graphique si l'image échoue au chargement
    if (img && fallback) {
      const showFallback = () => {
        img.style.display = 'none';
        fallback.style.display = 'flex';
      };
      img.addEventListener('error', showFallback);
      if (img.complete && img.naturalWidth === 0) {
        showFallback();
      }
    }

    const handleClick = () => {
      const raw = card.getAttribute('data-artwork');
      if (!raw) return;
      try {
        const detail = JSON.parse(raw);
        window.dispatchEvent(new CustomEvent('open-artwork-modal', { detail }));
      } catch (err) {
        console.error('[ImagePlaceholder] Données d’œuvre invalides :', err);
      }
    };

    frame?.addEventListener('click', handleClick);
    frame?.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        handleClick();
      }
    });
  });
</script>

<style lang="scss">
  @use '../styles/variables' as *;
  @use '../styles/mixins' as *;

  .image-placeholder-card {
    margin: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: $spacing-sm;
  }

  .image-frame {
    position: relative;
    width: 100%;
    background-color: $color-surface;
    border: 1px solid $color-border;
    border-radius: 0;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    outline: none;
    transition: border-color $transition-normal;

    &:hover,
    &:focus-visible {
      border-color: var(--card-hover-border, #{$color-primary});

      .card-zoom-badge {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }

  .card-tag {
    position: absolute;
    top: $spacing-md;
    left: $spacing-md;
    display: flex;
    align-items: center;
    gap: $spacing-xs;
    z-index: 10;
  }

  .s3-indicator-badge {
    font-family: monospace;
    font-size: 0.65rem;
    font-weight: $font-weight-semibold;
    background-color: rgba(30, 41, 59, 0.9);
    color: $color-white;
    padding: 0.12rem 0.45rem;
    border-radius: 0;
    letter-spacing: 0.05em;
  }

  .card-zoom-badge {
    position: absolute;
    top: $spacing-md;
    right: $spacing-md;
    background-color: rgba(255, 255, 255, 0.95);
    color: var(--badge-accent-color, #{$color-primary});
    border: 1px solid $color-border;
    border-radius: 0;
    font-size: 0.72rem;
    font-weight: $font-weight-medium;
    padding: 0.25rem 0.6rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(-2px);
    transition: all $transition-fast;
    z-index: 10;
  }

  // Image réelle directement chargée
  .real-artwork-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 0;
  }

  // Placeholder géométrique
  .art-grid-lines {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.25;

    .cross-h {
      position: absolute;
      top: 50%;
      left: 10%;
      right: 10%;
      height: 1px;
      border-top: 1px dashed $color-border-strong;
    }

    .cross-v {
      position: absolute;
      left: 50%;
      top: 10%;
      bottom: 10%;
      width: 1px;
      border-left: 1px dashed $color-border-strong;
    }
  }

  .frame-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: $spacing-xs;
    padding: $spacing-lg;
    z-index: 2;
  }

  .frame-symbol {
    font-size: 1.8rem;
    color: $color-muted;
    transition: transform $transition-smooth, color $transition-normal;
  }

  .frame-label {
    font-family: $font-family-base;
    font-size: 0.85rem;
    font-weight: $font-weight-medium;
    color: $color-text;
    letter-spacing: 0.05em;
  }

  .frame-hint {
    font-size: 0.72rem;
    color: $color-text-muted;
    max-width: 280px;
    word-break: break-all;
  }

  .image-caption {
    display: flex;
    align-items: baseline;
    gap: $spacing-xs;
    font-size: 0.75rem;
    color: $color-text-light;
    line-height: 1.4;

    .caption-marker {
      font-weight: $font-weight-semibold;
      color: var(--badge-accent-color, #{$color-primary});
    }
  }
</style>
