---
import '../styles/global.scss';
import SearchBar from '../components/SearchBar.astro';
import ArtworkModal from '../components/ArtworkModal.astro';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
}

const {
  title = "Patrick Laumond — Vitrine Métahisme",
  description = "Vitrine officielle d'exposition des œuvres de Patrick Laumond et du mouvement Métahiste.",
  currentPath = Astro.url.pathname,
} = Astro.props;

const navItems = [
  { href: '/', label: 'Frise Chronologique' },
  { href: '/interview', label: 'Entretien : Le Grand Mikado' },
  { href: '/partenaires', label: 'Partenaires' },
  { href: 'https://laumond.com', label: 'laumond.com ↗', external: true },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="app-layout">
      <!-- Navbar identique à laumond.com (Logo 2 lignes gris, Recherche centrale, Liens à droite) -->
      <header class="navbar" id="app-navbar">
        <div class="navbar-container">
          <!-- Logo Brand 2 lignes (Couleur et espacements originaux de laumond.com) -->
          <div class="navbar-brand">
            <a href="/" class="brand-link">
              <div class="brand-title">
                <span class="brand-name-top">Patrick</span>
                <span class="brand-name-bottom">Laumond</span>
              </div>
            </a>
          </div>

          <!-- Barre de recherche au centre (Exact laumond.com) -->
          <div class="navbar-search--desktop">
            <SearchBar />
          </div>

          <!-- Navigation principale à droite (Exact laumond.com) -->
          <nav class="navbar-nav" id="main-nav">
            <ul class="nav-list">
              {navItems.map((item) => {
                const isActive = !item.external && (currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href)));
                return (
                  <li class="nav-item">
                    <a
                      href={item.href}
                      target={item.external ? '_blank' : undefined}
                      rel={item.external ? 'noopener noreferrer' : undefined}
                      class={`nav-link ${isActive ? 'active' : ''}`}
                    >
                      {item.label}
                    </a>
                  </li>
                );
              })}
            </ul>
          </nav>

          <!-- Bouton Menu Mobile (Exact laumond.com) -->
          <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Ouvrir le menu">
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
          </button>
        </div>
      </header>

      <!-- Contenu de la page -->
      <main class="main-content">
        <slot />
      </main>

      <!-- Footer épuré galerie -->
      <footer class="app-footer">
        <div class="footer-container">
          <div class="footer-line"></div>
          <div class="footer-brand">
            <span class="footer-name">Patrick Laumond</span>
            <span class="footer-dot">&middot;</span>
            <span class="footer-theme">Le Grand Mikado de la pensée humaine</span>
          </div>
          <div class="footer-links">
            <a href="/" class="footer-link">Frise</a>
            <a href="/interview" class="footer-link">Entretien</a>
            <a href="/partenaires" class="footer-link">Partenaires</a>
            <a href="https://laumond.com" target="_blank" rel="noopener noreferrer" class="footer-link">laumond.com</a>
          </div>
          <div class="footer-copy">
            &copy; {new Date().getFullYear()} Patrick Laumond. Métahisme. Tous droits réservés.
          </div>
        </div>
      </footer>

      <!-- Modale de contemplation & d'analyse d'œuvre HD -->
      <ArtworkModal />
    </div>

    <script>
      // Menu mobile & effet scrolled navbar
      document.addEventListener('DOMContentLoaded', () => {
        const navbar = document.getElementById('app-navbar');
        const mobileBtn = document.getElementById('mobile-menu-btn');
        const mainNav = document.getElementById('main-nav');

        mobileBtn?.addEventListener('click', () => {
          mobileBtn.classList.toggle('active');
          mainNav?.classList.toggle('navbar-nav-open');
        });

        window.addEventListener('scroll', () => {
          if (window.scrollY > 20) {
            navbar?.classList.add('navbar-scrolled');
          } else {
            navbar?.classList.remove('navbar-scrolled');
          }
        }, { passive: true });
      });
    </script>
  </body>
</html>

<style lang="scss">
  @use '../styles/variables' as *;
  @use '../styles/mixins' as *;

  .app-layout {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background-color: $color-background;
  }

  // --- Navbar Exact laumond.com ---
  .navbar {
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    background: rgba(255, 255, 255, 0.95);
    border-bottom: 1px solid rgba(153, 153, 153, 0.15);
    position: sticky;
    top: 0;
    transition: all 0.3s ease;
    z-index: 1000;

    &.navbar-scrolled {
      background: rgba(255, 255, 255, 0.98);
      border-bottom-color: rgba(153, 153, 153, 0.25);
      box-shadow: 0 2px 20px rgba(0, 0, 0, 0.08);
    }
  }

  .navbar-container {
    align-items: center;
    display: flex;
    font-family: $font-family-base;
    gap: clamp(1rem, 2vw, 1.5rem);
    justify-content: space-between;
    margin: 0;
    max-width: 100%;
    min-height: 80px;
    padding: 1rem 2rem;

    @include respond-to('tablet') {
      padding: 0.75rem 1.25rem;
      min-height: 70px;
    }
  }

  .navbar-brand {
    flex-shrink: 0;
    white-space: nowrap;

    .brand-link {
      color: inherit;
      display: block;
      text-decoration: none;
    }

    .brand-title {
      color: $color-muted; // #999999 (Couleur originale de laumond.com)
      font-size: clamp(1.1rem, 2vw, 1.4rem);
      font-weight: 400;
      line-height: 1.05;
      margin: 0;
      text-transform: uppercase;
      transition: color 0.2s ease;

      &:hover {
        color: $color-text;
      }

      .brand-name-top {
        display: block;
        letter-spacing: 0.25em;
      }

      .brand-name-bottom {
        display: block;
        letter-spacing: 0.2em;
      }
    }
  }

  .navbar-search--desktop {
    flex: 1 1 auto;
    margin: 0 auto;
    max-width: 400px;
    min-width: 220px;

    @include respond-to('tablet') {
      display: none;
    }
  }

  .navbar-nav {
    align-items: center;
    display: flex;
    flex: 0 0 auto;
    flex-shrink: 0;
    gap: clamp(0.8rem, 1.8vw, 2.2rem);
    justify-content: flex-end;
    min-width: 0;

    .nav-list {
      align-items: center;
      display: flex;
      flex-wrap: nowrap;
      gap: clamp(0.6rem, 1.5vw, 1.8rem);
      list-style: none;
      margin: 0;
      min-width: 0;
      padding: 0;
      white-space: nowrap;

      .nav-item {
        .nav-link {
          color: $color-muted; // #999999
          font-size: clamp(0.72rem, 1.4vw, 0.88rem);
          font-weight: 500;
          letter-spacing: clamp(0.04em, 0.18vw, 0.08em);
          padding: 0.5rem 0;
          position: relative;
          text-decoration: none;
          text-transform: uppercase;
          transition: all 0.3s ease;

          &::after {
            background: $color-primary; // #cc0000
            bottom: -2px;
            content: '';
            height: 2px;
            left: 0;
            position: absolute;
            transition: width 0.3s ease;
            width: 0;
            border-radius: 0;
          }

          &.active,
          &:hover {
            color: $color-primary;

            &::after {
              width: 100%;
            }
          }
        }
      }
    }

    @include respond-to('tablet') {
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      background: rgba(255, 255, 255, 0.98);
      border-bottom: 1px solid rgba(153, 153, 153, 0.15);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
      flex-direction: column;
      gap: 1.5rem;
      left: 0;
      opacity: 0;
      padding: 2rem 1.5rem;
      position: fixed;
      right: 0;
      top: 70px;
      transform: translateY(-100%);
      transition: all 0.3s ease;
      visibility: hidden;

      &.navbar-nav-open {
        opacity: 1;
        transform: translateY(0);
        visibility: visible;
      }

      .nav-list {
        flex-direction: column;
        gap: 1.25rem;
        width: 100%;

        .nav-item {
          text-align: center;
          width: 100%;

          .nav-link {
            border-bottom: 1px solid rgba(153, 153, 153, 0.1);
            display: block;
            font-size: 0.95rem;
            padding: 0.75rem 0;

            &::after {
              display: none;
            }
          }
        }
      }
    }
  }

  .mobile-menu-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    display: none;
    flex-direction: column;
    height: 26px;
    justify-content: space-around;
    margin-left: auto;
    padding: 0;
    width: 28px;

    @include respond-to('tablet') {
      display: flex;
    }

    .hamburger-line {
      background: $color-muted;
      height: 2px;
      transform-origin: 1px;
      transition: all 0.3s ease;
      width: 100%;
    }

    &.active {
      .hamburger-line:first-child {
        transform: rotate(45deg);
      }
      .hamburger-line:nth-child(2) {
        opacity: 0;
      }
      .hamburger-line:nth-child(3) {
        transform: rotate(-45deg);
      }
    }
  }

  // --- Main Content ---
  .main-content {
    flex: 1;
    width: 100%;
  }

  // --- Footer Exact laumond.com ---
  .app-footer {
    background-color: $color-surface;
    border-top: 1px solid $color-border;
    padding: 30px 0;
    margin-top: auto;
  }

  .footer-container {
    @include content-container;
    max-width: 960px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: $spacing-md;
    text-align: center;
  }

  .footer-line {
    background: $color-ink;
    height: 1px;
    margin: 0 auto;
    width: 100px;
  }

  .footer-brand {
    font-size: 0.88rem;
    color: $color-text;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: center;

    .footer-name {
      font-weight: $font-weight-medium;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .footer-dot {
      color: $color-primary;
    }

    .footer-theme {
      color: $color-text-light;
      font-style: italic;
    }
  }

  .footer-links {
    display: flex;
    gap: $spacing-lg;
    flex-wrap: wrap;
    justify-content: center;

    .footer-link {
      font-size: 0.8rem;
      color: $color-text-muted;
      text-transform: uppercase;
      letter-spacing: 0.08em;

      &:hover {
        color: $color-primary;
      }
    }
  }

  .footer-copy {
    font-size: 0.72rem;
    color: $color-muted;
    letter-spacing: 0.04em;
  }
</style>
