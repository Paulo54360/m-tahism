# ==========================================
# Configuration Environnement — Vitrine Metahism
# ==========================================

# AWS S3 / CloudFront (Hébergement Médias HD Patrick Laumond)
# URL de base du bucket S3 (identique à laumond.com)
PUBLIC_S3_BASE_URL=https://plaumondpicture.s3.eu-west-3.amazonaws.com
S3_BUCKET=plaumondpicture
AWS_REGION=eu-west-3

# Optionnel (Uploads serveur & opérations administratives)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
